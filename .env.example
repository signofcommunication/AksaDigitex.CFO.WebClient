# Salin ke `.env` dan sesuaikan. Vite/Quasar memuat variabel `VITE_*` saat `quasar dev` / `quasar build`.

# Origin backend CFO API: protocol + host + port, TANPA path /api (path /api ditambahkan di kode).
# Contoh lokal:
VITE_BACKEND_API_URL=https://localhost:55585

# Di UI login, email administrator@aksadigitex.com memunculkan field untuk override URL di browser
# (berguna bila server default mati — tersimpan di localStorage, tidak mengubah file .env).

# Opsional — path relatif ke origin di atas (default di app: /api/companies)
# VITE_ACCURATE_HEALTH_PATH=/api/companies
